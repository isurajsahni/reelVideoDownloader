# Server
PORT=3001
NODE_ENV=development

# CORS - comma-separated origins (e.g. http://localhost:5173,https://yourdomain.com)
CORS_ORIGINS=http://localhost:5173

# Rate limiting - max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Temporary files - directory for downloads (auto-created), cleanup after seconds
TEMP_DIR=./temp
TEMP_FILE_TTL_SECONDS=300

# FFmpeg - path to ffmpeg binary (optional; leave empty to auto-detect)
FFMPEG_PATH=

# Optional: yt-dlp path (used for Instagram/Snapchat; leave empty to auto-detect)
YT_DLP_PATH=
